server {
    listen 80;
    server_name _;

    client_max_body_size 100m;

    # ========== 新增全局gzip压缩（核心优化JSON大包） ==========
    gzip on;
    gzip_min_length 1024;
    gzip_types application/json text/plain text/css text/javascript application/javascript;
    gzip_vary on;
    gzip_comp_level 4;
    gzip_buffers 4 64k;


    # 超时优化，带宽拥堵时延长等待
    proxy_connect_timeout 60s;
    proxy_read_timeout 60s;

    root /var/www/toonflow;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ ^/(game|voice|setting|other|user|project|prompt|index|novel|outline|script|storyboard|task|video|app)/ {
        proxy_pass http://127.0.0.1:60002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 新增：代理缓冲区，处理2MB+大JSON响应
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;
        proxy_busy_buffers_size 256k;
    }

    location ~ ^/([0-9]+|u_[0-9]+)/(game|voice)/ {
        proxy_pass http://127.0.0.1:60002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 同步添加缓冲区配置
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;
        proxy_busy_buffers_size 256k;
    }
}