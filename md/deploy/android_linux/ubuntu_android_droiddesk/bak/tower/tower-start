#!/bin/bash
# tower-start — 启动 tower-pm2 守护进程
# 用法: bash tower-start [端口 默认7088]
set -euo pipefail

PORT="${1:-7088}"
PDIR="/opt/droiddesk/tower"
LOG="/var/log/tower/tower-pm2.log"
PID_FILE="/run/tower/tower-pm2.pid"

# 单实例锁
if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "tower-pm2 already running (PID $OLD_PID). Exiting."
        exit 0
    fi
    rm -f "$PID_FILE"
fi

mkdir -p /run/tower /var/log/tower

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting tower-pm2 on port $PORT..." >> "$LOG"

setsid bash -c "
    nohup python3 '$PDIR/tower-pm2.py' --port $PORT >> '$LOG' 2>&1 &
    echo \$! > '$PID_FILE'
" </dev/null

sleep 1
NEW_PID=$(cat "$PID_FILE" 2>/dev/null || echo "")
if [ -n "$NEW_PID" ] && kill -0 "$NEW_PID" 2>/dev/null; then
    echo "tower-pm2 started (PID $NEW_PID, port $PORT)"
else
    echo "ERROR: tower-pm2 failed to start. Check $LOG"
    exit 1
fi